<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Test Suite">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.smsolutions.tests.CrossBrowserAdminTests"/>
            <class name="com.smsolutions.tests.CrossBrowserClientTests"/>
            <class name="com.smsolutions.tests.CrossBrowserSupportTests"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.smsolutions.tests.CrossBrowserAdminTests"/>
            <class name="com.smsolutions.tests.CrossBrowserClientTests"/>
            <class name="com.smsolutions.tests.CrossBrowserSupportTests"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.smsolutions.tests.CrossBrowserAdminTests"/>
            <class name="com.smsolutions.tests.CrossBrowserClientTests"/>
            <class name="com.smsolutions.tests.CrossBrowserSupportTests"/>
        </classes>
    </test>

    <!-- Safari tests: will only run successfully on macOS with SafariDriver enabled -->
    <test name="Safari Tests">
        <parameter name="browser" value="safari"/>
        <classes>
            <class name="com.smsolutions.tests.CrossBrowserAdminTests"/>
            <class name="com.smsolutions.tests.CrossBrowserClientTests"/>
            <class name="com.smsolutions.tests.CrossBrowserSupportTests"/>
        </classes>
    </test>

</suite>
